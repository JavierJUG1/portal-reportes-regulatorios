# ------------------------------------------------------------------
# Portal de reportes regulatorios · CRC y MinTIC — configuración
# Copia este archivo como backend/.env y completa los valores.
# ------------------------------------------------------------------

# Entorno: development | production  (production → cookies "Secure" y etiqueta PRODUCCIÓN)
APP_ENV=development
# Texto del chip del encabezado (por defecto PRODUCCIÓN / DESARROLLO según APP_ENV)
# ENV_LABEL=PRODUCCIÓN
# Clave para firmar la sesión del portal (cadena larga y aleatoria en producción)
SECRET_KEY=cambia-esta-clave
TIMEZONE=America/Bogota
# Subruta si el portal se publica detrás de un proxy (p. ej. /portal_reportes_crc); vacío = raíz del dominio
BASE_PATH=

# ---------------- ERPNext ----------------
ERPNEXT_URL=https://next.gigafibra.co
# API key / secret de un usuario de servicio con lectura de Subscription, Subscription Plan,
# Sales Invoice e Issue, y permiso para ejecutar el método monthly_subscription_snapshot.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=GIGA FIBRA SAS
SNAPSHOT_METHOD=monthly_subscription_snapshot

# Fuente de datos: erpnext (API real) | fixture (JSON locales para pruebas sin credenciales)
DATA_SOURCE=erpnext
# FIXTURE_DIR=ruta/a/fixtures

# ---------------- Inicio de sesión ----------------
# debug  → login local de desarrollo (correo @gigafibra.co, sin contraseña)
# erpnext → SSO con ERPNext (el mismo login de ERPNext con Office 365)
AUTH_MODE=erpnext
SESSION_HOURS=12
ALLOWED_EMAIL_DOMAINS=gigafibra.co
# Roles de ERPNext que pueden entrar (vacío = cualquier usuario del dominio). Ej: System Manager,Regulatorio
ALLOWED_ROLES=
# OAuth Client creado en ERPNext (ver README): Skip Authorization = 1
# Roles de ERPNext que pueden generar reportes desde el portal (nuevas versiones, periodos sin archivo,
# reintentos). Los demás usuarios solo consultan y descargan. Se verifica en ERPNext con la API key del portal
# y se recuerda ROLE_CACHE_SECONDS. Las generaciones automáticas no dependen de esto ("Generado por el sistema").
GENERATE_ROLES=System Manager
ROLE_CACHE_SECONDS=300
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
OAUTH_SCOPES=openid all
POST_LOGIN_REDIRECT=/

# ---------------- Archivos generados ----------------
# local  → backend/storage/ (temporal)
# erpnext → File privado en ERPNext (recomendado para producción)
STORAGE_BACKEND=local
ERPNEXT_FILE_FOLDER=Home
# STORAGE_DIR=storage
# DB_PATH=data/portal.db

# ---------------- Reportes habilitados ----------------
# f6 y t12 (trimestrales) y cortes (corte mensual de suscripciones). Cada corte queda ligado a su
# trimestre: el mes 1, 2 y 3 del trimestre son los MES 1, 2 y 3 del F6, y el corte del mes 3 es la base del T1.2.
ENABLED_REPORTS=f6,t12,cortes

# ---------------- Programación automática ----------------
SCHEDULER_ENABLED=true
# Hora de ejecución el último día del mes (cortes) y del trimestre (F6 y T1.2).
# Al cierre del trimestre también se generan los cortes del trimestre que falten.
SCHEDULE_HOUR=23
SCHEDULE_MINUTE=50
# Al iniciar, genera el último periodo cerrado si no tiene versión (p. ej. si el servidor estaba apagado)
CATCH_UP_ON_START=true
# Primer periodo listado en el portal (AAAA-MM)
HISTORY_START=2025-01

# ---------------- Reglas regulatorias ----------------
# TV incluida sin costo ("Giga Fibra TV - Free") cuenta como suscriptor de TV en F6 y como Duo Play en T1.2
INCLUDE_FREE_TV=true
# Fuente de verdad: lo que entrega la API para cada corte. AJUSTE_AL_CORTE=true reconstruye además
# planes/estrato/ubicación/"Disabled TV" al corte desde tabVersion (más lento; desactivado por criterio de Regulatorio)
AJUSTE_AL_CORTE=false
# Solo con AJUSTE_AL_CORTE: TV con "Disabled TV" al corte no cuenta como TV
EXCLUDE_DISABLED_TV=false
# F6: estados al corte que cuentan y si se excluyen las cuentas de uso propio
F6_STATUSES=Active,Past Due Date,Unpaid
F6_EXCLUDE_OWN_USE=false
# Velocidad en T1.2: contratada (nombre del plan) | aprovisionada (custom_download/custom_upload)
SPEED_SOURCE=contratada
# F6 TIPO_TECNOLOGIA: 5 = IPTV por fibra · T1.2 ID_TECNOLOGIA_ACCESO: 108 = FTTH
F6_TECNOLOGIA=5
T12_TECNOLOGIA_INTERNET=108
# Pestañas del T1.2 que se llenan (ingresos, accesos, quejas); las demás se quitan del archivo. INFO se conserva.
T12_SHEETS=accesos
# Estados de suscripción contados en T1.2: conectados incluyendo suspendidos (F6_STATUSES está arriba)
T12_STATUSES=Active,Past Due Date,Unpaid,Temporarily Suspended,Trialling
# Cliente cuyo nombre identifica accesos de uso propio (segmento 109)
OWN_USE_CUSTOMER_PATTERN=GIGA\s*FIBRA

# ---------------- Geografía DANE ----------------
# Departamentos cargados para ubicar coordenadas (11 Bogotá, 25 Cundinamarca)
GEO_DEPARTMENTS=11,25
# Si la coordenada está a más de N km del municipio declarado, se usa la ciudad
GEO_MAX_DISTANCE_KM=15
GEO_DEFAULT_MUNICIPIO=11001
